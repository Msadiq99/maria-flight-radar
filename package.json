{
  "name": "maria-flight-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "dev:backend": "npm --prefix backend run dev",
    "dev:preflight": "node scripts/check-dev-ports.mjs",
    "dev:all": "npm run dev:preflight && node scripts/dev-all.mjs",
    "dev:check": "node scripts/check-dev-services.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run src",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
