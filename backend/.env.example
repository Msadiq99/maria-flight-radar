PORT=8080
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173

# Radar defaults. Use non-private, intentionally approximate values here.
MARIA_RADAR_LATITUDE=24.7136
MARIA_RADAR_LONGITUDE=46.6753
MARIA_DEFAULT_RANGE_KM=100
MARIA_MAX_RANGE_KM=250
MARIA_SOURCE_MODE=auto
MARIA_SOURCE_PRIORITY=local_adsb,simulation
MARIA_SIMULATION_FALLBACK=true
MARIA_RADAR_CACHE_TTL_MS=10000

# Optional OpenSky OAuth2 client-credentials integration. Disabled by default.
OPENSKY_ENABLED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_BASE_URL=https://opensky-network.org/api

# Local ADS-B receiver, for readsb/dump1090 aircraft.json.
LOCAL_ADSB_ENABLED=false
LOCAL_ADSB_BASE_URL=http://localhost:8080
LOCAL_ADSB_AIRCRAFT_PATH=/data/aircraft.json
LOCAL_ADSB_SIMULATOR=false
